{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openhistory-website",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": {
    "directory": "dist/client"
  },
  "routes": [
    {
      "pattern": "openhistory.sh",
      "custom_domain": true
    },
    {
      "pattern": "www.openhistory.sh",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ]
}
