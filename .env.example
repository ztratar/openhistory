# Copy this file to .env.local. Never commit .env.local.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=

# A cost-conscious default for high-volume summarization.
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_MODEL=claude-sonnet-5
MOONSHOT_MODEL=kimi-k3

# Optional private OpenAI-compatible server (oMLX, LM Studio, llama.cpp, Ollama).
# Only loopback, private-network, Tailscale, and .local addresses are accepted.
LOCAL_INFERENCE_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_INFERENCE_MODEL=mlx-community/Qwen3.5-9B-4bit
# Leave empty unless your server requires a bearer token.
LOCAL_INFERENCE_API_KEY=

# Optional. When empty, Electron uses its per-user application data directory.
OPENHISTORY_DATA_DIR=

# Set to 1 only when deliberately adopting an existing, nonempty custom activity-data directory.
OPENHISTORY_ADOPT_DATA_DIR=

# Optional stable loopback port for read-only local MCP agent access.
OPENHISTORY_MCP_PORT=47831
